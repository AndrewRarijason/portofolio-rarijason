# Copier ce fichier en .env.local (développement) et renseigner les mêmes
# variables dans Vercel > Project > Settings > Environment Variables.

# URL de production (sitemap, URL canoniques, images OpenGraph)
NEXT_PUBLIC_SITE_URL=https://andrew-rarijason.vercel.app

# Umami : https://cloud.umami.is > Settings > Websites > Add website > "Website ID"
# Le script n'est chargé que si cette variable est définie.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Google Search Console : méthode "Balise HTML", ne garder que la valeur de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
